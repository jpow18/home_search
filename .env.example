# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
RENTCAST_API_KEY=your-rentcast-api-key

# Email alerts are optional.
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=HomeSeek <alerts@your-domain.com>

# Required for a public deployment.
APP_PASSWORD=choose-a-long-password
CRON_SECRET=choose-another-random-secret
